# Copy to .env. Start from the repository root after `corepack yarn build`:
# node --env-file=.env packages/cli/dist/bin.js
BULL_BOARD_REDIS_URL=redis://127.0.0.1:6379
BULL_BOARD_PREFIX=bull
# Leave empty to discover all queues under the configured prefix(es).
BULL_BOARD_QUEUES=
BULL_BOARD_SCAN_INTERVAL=10
BULL_BOARD_HOST=127.0.0.1
BULL_BOARD_PORT=3000
BULL_BOARD_OPEN=false
# Optional dashboard pathname. Example: /bul serves the UI and API under /bul.
# The root / does not redirect to this pathname.
# Leave empty (or /) to keep the dashboard at root. Restart after changing.
BULL_BOARD_BASE_PATH=
BULL_BOARD_READ_ONLY=false
# Set both to enable the existing dashboard Basic authentication.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# Only terminal failed jobs trigger alerts. Intermediate retries do not.
# Enable the master switch AND at least one channel, then restart the CLI.
BULL_BOARD_NOTIFICATIONS_ENABLED=false
BULL_BOARD_NOTIFICATION_APP_NAME=bull-board
# Public dashboard root, including base path, e.g. https://queues.example.com/board.
# Optional; leave empty to omit navigation links. No credentials, query or fragment.
BULL_BOARD_NOTIFICATION_BOARD_URL=

BULL_BOARD_DISCORD_ENABLED=false
BULL_BOARD_DISCORD_WEBHOOK_URL=
# Optional forum/thread snowflake ID.
BULL_BOARD_DISCORD_THREAD_ID=

BULL_BOARD_TELEGRAM_ENABLED=false
BULL_BOARD_TELEGRAM_BOT_TOKEN=
# Numeric chat ID (negative for groups), or @channel_username.
BULL_BOARD_TELEGRAM_CHAT_ID=
# Optional positive topic ID for a Telegram forum group.
BULL_BOARD_TELEGRAM_MESSAGE_THREAD_ID=

# HTTP timeout (100..60000 ms).
BULL_BOARD_NOTIFICATION_TIMEOUT_MS=10000
# Total delivery attempts including the first send (1..10).
BULL_BOARD_NOTIFICATION_MAX_ATTEMPTS=3
# Initial exponential backoff (10..60000 ms); honors provider Retry-After.
BULL_BOARD_NOTIFICATION_RETRY_DELAY_MS=1000
# Maximum queued + active deliveries across both channels (1..10000).
BULL_BOARD_NOTIFICATION_MAX_PENDING=200
